<?xml version="1.0"?>
<mujoco>
  <compiler angle="radian" meshdir="../../robot/kinova_mesh"/>
  <option timestep="0.001" iterations="50" tolerance="1e-8">
    <flag warmstart="enable"/>
  </option>

  <asset>
    <!-- Kinova Meshes -->
    <mesh name="base_mesh" file="base_link.STL"/>
    <mesh name="shoulder_mesh" file="shoulder_link.STL"/>
    <mesh name="halfarm1_mesh" file="half_arm_1_link.STL"/>
    <mesh name="halfarm2_mesh" file="half_arm_2_link.STL"/>
    <mesh name="forearm_mesh" file="forearm_link.STL"/>
    <mesh name="wrist1_mesh" file="spherical_wrist_1_link.STL"/>
    <mesh name="wrist2_mesh" file="spherical_wrist_2_link.STL"/>
    <mesh name="bracelet_mesh" file="bracelet_with_vision_link.STL"/>

    <!-- Robotiq Gripper Meshes -->
    <mesh name="gripper_base" file="robotiq_arg2f_85_base_link.STL"/>
    <mesh name="outer_knuckle" file="robotiq_arg2f_85_outer_knuckle.STL"/>
    <mesh name="outer_finger" file="robotiq_arg2f_85_outer_finger.STL"/>
    <mesh name="inner_knuckle" file="robotiq_arg2f_85_inner_knuckle.STL"/>
    <mesh name="inner_finger" file="robotiq_arg2f_85_inner_finger.STL"/>

    <material name="robot_mat" rgba="0.75 0.75 0.75 1"/>
    <material name="gripper_mat" rgba="0.792 0.82 0.933 1"/>
    <material name="gripper_blue" rgba="0.792 0.82 0.933 1"/>
    <material name="gripper_gray" rgba="0.1 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Kinova Arm Base -->
    <body name="base_link" pos="0.9 0 0.95">
      <inertial pos="-0.000648 -0.000166 0.084487" mass="1.697" diaginertia="0.004622 0.004495 0.002079"/>
      <geom type="mesh" mesh="base_mesh" material="robot_mat"/>

      <!-- Shoulder Joint -->
      <body name="Shoulder_Link" pos="0 0 0.15643" euler="3.1416 0 0">
        <joint name="Actuator1" type="hinge" axis="0 0 1" limited="true" range="-6.283 6.283"/>
        <inertial pos="-0.000023 -0.010364 -0.07336" mass="1.3773" diaginertia="0.00457 0.004831 0.001409"/>
        <geom type="mesh" mesh="shoulder_mesh" material="robot_mat"/>

        <!-- Half Arm 1 -->
        <body name="HalfArm1_Link" pos="0 0.005375 -0.12838" euler="1.5708 0 0">
          <joint name="Actuator2" type="hinge" axis="0 0 1" range="-2.41 2.41"/>
          <inertial pos="-0.000044 -0.09958 -0.013278" mass="1.1636" diaginertia="0.011088 0.001072 0.011255"/>
          <geom type="mesh" mesh="halfarm1_mesh" material="robot_mat"/>

          <!-- Half Arm 2 -->
          <body name="HalfArm2_Link" pos="0 -0.21038 -0.006375" euler="-1.5708 0 0">
            <joint name="Actuator3" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
            <inertial pos="-0.000044 -0.006641 -0.117892" mass="1.1636" diaginertia="0.010932 0.011127 0.001043"/>
            <geom type="mesh" mesh="halfarm2_mesh" material="robot_mat"/>

            <!-- Forearm -->
            <body name="ForeArm_Link" pos="0 0.006375 -0.21038" euler="1.5708 0 0">
              <joint name="Actuator4" type="hinge" axis="0 0 1" range="-2.66 2.66"/>
              <inertial pos="-0.000018 -0.075478 -0.015006" mass="0.9302" diaginertia="0.008147 0.000631 0.008316"/>
              <geom type="mesh" mesh="forearm_mesh" material="robot_mat"/>

              <!-- Spherical Wrist 1 -->
              <body name="SphericalWrist1_Link" pos="0 -0.20843 -0.006375" euler="-1.5708 0 0">
                <joint name="Actuator5" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
                <inertial pos="0.000001 -0.009432 -0.063883" mass="0.6781" diaginertia="0.001596 0.001607 0.000399"/>
                <geom type="mesh" mesh="wrist1_mesh" material="robot_mat"/>

                <!-- Spherical Wrist 2 -->
                <body name="SphericalWrist2_Link" pos="0 0.000175 -0.10593" euler="1.5708 0 0">
                  <joint name="Actuator6" type="hinge" axis="0 0 1" range="-2.23 2.23"/>
                  <inertial pos="0.000001 -0.045483 -0.00965" mass="0.6781" diaginertia="0.001641 0.00041 0.001641"/>
                  <geom type="mesh" mesh="wrist2_mesh" material="robot_mat"/>

                  <!-- Bracelet Link -->
                  <body name="Bracelet_Link" pos="0 -0.10593 -0.000175" euler="-1.5708 0 0">
                    <joint name="Actuator7" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
                    <inertial pos="-0.000281 -0.011402 -0.029798" mass="0.5006" diaginertia="0.000587 0.000369 0.000609"/>
                    <geom type="mesh" mesh="bracelet_mesh" material="robot_mat"/>

                    <!-- End Effector with Gripper -->
                    <body name="EndEffector_Link" pos="0 0 -0.061525" euler="3.1416 0 0">

                      <!-- Gripper Base Link -->
                      <body name="robotiq_arg2f_base_link" pos="0 0 0" euler="0 0 0">
                        <inertial pos="0 0 0.06" mass="0.5" diaginertia="0.001 0.001 0.001"/>
                        <geom type="mesh" mesh="gripper_base" material="gripper_blue"/>

                          <!--Left Finger Kinematic Chain -->
                        <body name="left_outer_knuckle" pos="0 -0.0306 0.0549" euler="1.5708 0 3.1416">
                          <inertial pos="-0.0002 0.02922 0.01994" mass="0.00853" diaginertia="2.893e-6 1.219e-6 1.867e-6"/>
                          <geom type="mesh" mesh="outer_knuckle" material="gripper_blue"/>
<!--                          <joint name="finger_joint" type="hinge" axis="0 1 0" range="0 0.8"/>-->

                          <body name="left_outer_finger" pos="0 -0.0041 0.0315">
                            <inertial pos="0.0003 -0.0208 0.03739" mass="0.0226" diaginertia="1.525e-5 1.164e-5 6.176e-6"/>
                            <geom type="mesh" mesh="outer_finger" material="gripper_gray"/>

                            <body name="left_inner_knuckle" pos="0 -0.0127 -0.0614 ">
                              <joint name="left_inner_joint" type="hinge" axis="0 1 0" range="-0.8757 0.8757"/>
                              <inertial pos="0.00012 0.00104 0.05079" mass="0.0271" diaginertia="2.619e-5 2.836e-5 2.827e-6"/>
                              <geom type="mesh" mesh="inner_knuckle" material="gripper_gray"/>

                              <body name="left_inner_finger" pos="0 -0.0371 0.061" euler="0 0 0">
                                <inertial pos="0.0003 -0.01369 0.01601" mass="0.0104" diaginertia="2.719e-6 2.303e-6 7.691e-7"/>
                                <geom type="mesh" mesh="inner_finger" material="gripper_gray"/>

                                <body name="left_finger_pad" pos="0 -0.0324 -0.022" euler="1.5708 0 0">
                                  <geom type="box" size="0.011 0.0032 0.0188" rgba="0.9 0.9 0.9 1"/>
                                  <site name="left_tip_sensor_site" pos="0 0 0" size="0.005" rgba="0 0 1 1"/>
                                </body>
                              </body>
                            </body>
                          </body>
                        </body>

                        <!--Right Finger Kinematic Chain (Mirrored) -->
                        <body name="right_outer_knuckle" pos="0 0.0306 0.0549" euler="-1.5708 0 0">
                          <inertial pos="-0.0002 0.02922 0.01994" mass="0.00853" diaginertia="2.893e-6 1.219e-6 1.867e-6"/>
                          <geom type="mesh" mesh="outer_knuckle" material="gripper_blue"/>
<!--                          <joint name="right_finger_joint" type="hinge" axis="0 1 0" range="0 0.81"/>-->

                          <body name="right_outer_finger" pos="0 -0.0041 0.0315">
                            <inertial pos="0.0003 -0.0208 0.03739" mass="0.0226" diaginertia="1.525e-5 1.164e-5 6.176e-6"/>
                            <geom type="mesh" mesh="outer_finger" material="gripper_gray"/>

                            <body name="right_inner_knuckle" pos="0 -0.0127 -0.0614">
                              <joint name="right_inner_joint" type="hinge" axis="0 1 0" range="-0.8757 0.8757"/>
                              <inertial pos="0.00012 0.00104 0.05079" mass="0.0271" diaginertia="2.619e-5 2.836e-5 2.827e-6"/>
                              <geom type="mesh" mesh="inner_knuckle" material="gripper_gray"/>

                              <body name="right_inner_finger" pos="0 -0.0371 0.061">
                                <inertial pos="0.0003 -0.01369 0.01601" mass="0.0104" diaginertia="2.719e-6 2.303e-6 7.691e-7"/>
                                <geom type="mesh" mesh="inner_finger" material="gripper_gray"/>

                                <body name="right_finger_pad" pos="0 -0.0324 -0.022" euler="-1.5708 0 0">
                                  <geom type="box" size="0.011 0.0032 0.0188" rgba="0.9 0.9 0.9 1"/>
                                  <site name="right_tip_sensor_site" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
                                </body>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <camera name="front_cam"
          mode="fixed"
          pos="4 0 1.3"
          euler="-1.5708 1.5708 0"
          fovy="45" />

    <camera name="side_cam"
          mode="fixed"
          pos="4 -2.3 1.3"
          euler="-1.5708 2.0944 0"
          fovy="45" />

    <camera name="top_cam"
          mode="fixed"
          pos="0 0 5"
          euler="0 0 0"
          fovy="45" />
  </worldbody>

  <actuator>
    <!-- Arm Actuators -->
    <motor joint="Actuator1" name="joint1" gear="39" ctrllimited="true" ctrlrange="-6.283 6.283"/>
    <motor joint="Actuator2" name="joint2" gear="39" ctrllimited="true" ctrlrange="-2.41 2.41"/>
    <motor joint="Actuator3" name="joint3" gear="39" ctrllimited="true" ctrlrange="-6.283 6.283"/>
    <motor joint="Actuator4" name="joint4" gear="39" ctrllimited="true" ctrlrange="-2.66 2.66"/>
    <motor joint="Actuator5" name="joint5" gear="9" ctrllimited="true" ctrlrange="-6.283 6.283"/>
    <motor joint="Actuator6" name="joint6" gear="9" ctrllimited="true" ctrlrange="-2.23 2.23"/>
    <motor joint="Actuator7" name="joint7" gear="9" ctrllimited="true" ctrlrange="-6.283 6.283"/>

    <!-- Gripper Actuator -->
<!--    <motor joint="finger_joint" name="gripper" gear="1000" ctrllimited="true" ctrlrange="0 0.008"/>-->
  </actuator>

  <sensor>
    <force name="right_tip_force" site="right_tip_sensor_site"/>
    <force name="left_tip_force" site="left_tip_sensor_site"/>
  </sensor>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="10"/>
  </visual>
</mujoco>